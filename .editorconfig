root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.md]
max_line_length = 120
ij_markdown_wrap_text_if_long = true
# Markdown uses two trailing spaces as a hard line break
trim_trailing_whitespace = false

[*.{yml,yaml,json,xml}]
indent_size = 2
